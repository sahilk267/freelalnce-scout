# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PERSISTENCE HARDENING OPTIONS
BACKUP_INTERVAL_MINUTES="60"
BACKUP_RETENTION_COUNT="10"
BACKUP_DIRECTORY="./backups"
BACKUP_DATABASE_FILENAME="backup.sqlitedb"
RETRY_COUNT="3"
RETRY_DELAY_MS="1000"
RETRY_MAX_DELAY_MS="10000"
RETRY_ABORT_THRESHOLD_MS="30000"
SCHEDULER_ENABLED="true"
LOG_LEVEL="info"
MANIFEST_FILENAME="manifest.json"
COMPRESSION_ENABLED="false"

# SECURITY & AUTHENTICATION HARDENING
AZIZ_API_KEY="YOUR_AZIZ_API_KEY_HERE"
JWT_SECRET="YOUR_JWT_SECRET_HERE"
FIREBASE_SERVICE_ACCOUNT_JSON=""

# GOOGLE CALENDAR INTEGRATION
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
CALENDAR_TOKEN_ENCRYPTION_KEY="32-byte-hex-or-base64-encryption-key"
CALENDAR_PROVIDER="inmemory" # "inmemory" | "google"

# FREELANCE PLATFORM OFFICIAL APIS (Bypasses Cloudflare / Anti-bot Scraper Blocks)
# How to get official Upwork API credentials:
# 1. Register a developer account at https://www.upwork.com/developer
# 2. Create an App under API Keys with read access to Job Search GraphQL endpoints
# 3. Generate an OAuth2 bearer token or configure client key credentials below
UPWORK_API_KEY=""
UPWORK_ACCESS_TOKEN=""

# Freelancer.com Developer Access: https://www.freelancer.com/developers
FREELANCER_API_KEY=""

# FIVERR_API_KEY:
FIVERR_API_KEY=""

# AI MODEL PROVIDER ROUTER & FAILOVER CONFIGURATION
# Primary provider: "gemini" (default), "anthropic", "openai", "deepseek", "qwen", "ollama", "lmstudio"
AI_PROVIDER_PRIMARY="gemini"
# Fallback provider: opt-in second provider (e.g., "anthropic", "openai")
AI_PROVIDER_FALLBACK=""
# Number of consecutive failures before engaging cooldown failover
AI_PROVIDER_FAILOVER_THRESHOLD="3"
# Cooldown duration in milliseconds before testing primary provider recovery
AI_PROVIDER_COOLDOWN_MS="30000"

# Optional Alternative Provider API Keys
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""


