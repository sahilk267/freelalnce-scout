rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCandidate(candidate) {
      return candidate.name is string && candidate.name.size() > 0 && candidate.name.size() <= 100
        && (candidate.experienceYears is int || candidate.experienceYears is float) && candidate.experienceYears >= 0
        && candidate.locationPreference is string && candidate.locationPreference.size() <= 100
        && candidate.skills is list && candidate.skills.size() <= 50;
    }

    // Zero-Trust Access Control: Candidate profiles and PII restricted strictly to authenticated sessions
    match /candidates/{candidateId} {
      allow get: if request.auth != null && isValidId(candidateId);
      allow list: if request.auth != null;
      allow create: if request.auth != null && isValidId(candidateId) && isValidCandidate(request.resource.data);
      allow update: if request.auth != null && isValidId(candidateId) && isValidCandidate(request.resource.data)
                    && request.resource.data.name == resource.data.name;
      allow delete: if request.auth != null && isValidId(candidateId);
    }
  }
}
